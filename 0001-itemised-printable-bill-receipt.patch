+// ---- itemised receipt -----------------------------------------------------
+
+export type BillReceiptLine = {
+  name: string;
+  qty: number;
+  unitRupees: number;
+  lineRupees: number;
+};
+
+export type BillReceipt = {
+  /** BILL-001 style label. */
+  billNumber: string;
+  /** ORD-001 style label (null only if the order row is missing). */
+  orderNumber: string | null;
+  /** ISO timestamp the bill was generated. */
+  issuedAt: string;
+  tableLabel: string;
+  lines: BillReceiptLine[];
+  subtotalRupees: number;
+  gstRupees: number;
+  serviceChargeRupees: number;
+  discountRupees: number;
+  totalRupees: number;
+  paidRupees: number;
+  remainingRupees: number;
+  status: PaymentStatus;
+  payments: {
+    method: "cash" | "qr";
+    amountRupees: number;
+    transactionId: string | null;
+    paidAt: string;
+  }[];
+};
+
+export function formatSequence(prefix: "BILL" | "ORD", n: number | null): string | null {
+  return n === null || n === undefined ? null : `${prefix}-${String(n).padStart(3, "0")}`;
+}
+
+/**
+ * Everything the bill popup / printable receipt shows, read from PostgreSQL:
+ * the bill, the order's persisted line items (name snapshot, qty, unit price,
+ * line total), the table, and the recorded payments. Nothing is recomputed
+ * from the menu, so the receipt always matches what was actually ordered.
+ */
+export async function getBillReceiptDb(
+  restaurantId: string,
+  billId: string
+): Promise<BillReceipt | null> {
+  const [row] = await db
+    .select()
+    .from(bills)
+    .where(and(eq(bills.id, billId), eq(bills.restaurantId, restaurantId)));
+  if (!row) return null;
+
+  const bill = toBill(row);
+
+  const [orderRow] = await db
+    .select({ orderNumber: orders.orderNumber })
+    .from(orders)
+    .where(and(eq(orders.id, row.orderId), eq(orders.restaurantId, restaurantId)));
+
+  const [tableRow] = await db
+    .select({ label: restaurantTables.label })
+    .from(restaurantTables)
+    .where(
+      and(
+        eq(restaurantTables.id, row.tableId),
+        eq(restaurantTables.restaurantId, restaurantId)
+      )
+    );
+
+  const itemRows = await db
+    .select()
+    .from(orderItems)
+    .where(eq(orderItems.orderId, row.orderId))
+    .orderBy(asc(orderItems.createdAt), asc(orderItems.nameSnapshot));
+
+  const summary = await summaryFor(db, bill);
+
+  return {
+    billNumber: formatSequence("BILL", row.billNumber) ?? row.id,
+    orderNumber: formatSequence("ORD", orderRow?.orderNumber ?? null),
+    issuedAt: row.createdAt.toISOString(),
+    tableLabel: tableRow?.label ?? row.tableId,
+    lines: itemRows.map((i) => ({
+      name: i.nameSnapshot,
+      qty: i.qty,
+      unitRupees: i.pricePaise / 100,
