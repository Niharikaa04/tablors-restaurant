@@ -0,0 +1,182 @@
+/**
+ * Order → itemised bill → payments, against real PostgreSQL, through the same
+ * server actions the customer device calls. Run: TEST_DATABASE_URL=... npm run test:db
+ */
+import { beforeAll, describe, expect, it, vi } from "vitest";
+import { readFileSync } from "node:fs";
+
+vi.mock("next/cache", () => ({ revalidatePath: vi.fn() }));
+
+const url = process.env.TEST_DATABASE_URL;
+const RID = "demo-restaurant";
+const REF = `UTR${Date.now()}Rcpt`;
+
+describe("payment popup source", () => {
+  it("no longer contains the Open UPI App button or a upi:// link", () => {
+    const src = readFileSync("src/components/customer/device/payment-panel.tsx", "utf8");
+    expect(src).not.toMatch(/Open UPI App/i);
+    expect(src).not.toMatch(/href=\{upiUri\}/);
+    expect(src).not.toMatch(/location\.href\s*=.*upi/i);
+    // QR + UPI id display are kept.
+    expect(src).toMatch(/QRCodeSVG/);
+    expect(src).toMatch(/UPI ID:/);
+  });
+});
+
+describe.skipIf(!url)("itemised bill from PostgreSQL", () => {
+  let orders: typeof import("@/server/modules/orders/db-orders");
+  let billing: typeof import("@/server/modules/billing/db-billing");
+  let customer: typeof import("@/server/modules/customer/actions");
+  let dbmod: typeof import("@/server/db/client");
+  let schema: typeof import("@/server/db/schema");
+  let eq: typeof import("drizzle-orm").eq;
+  let menu: { id: string; code: string; name: string }[];
+
+  beforeAll(async () => {
+    process.env.DATABASE_URL = url;
+    process.env.RESTAURANT_UPI_ID = "tablor@upi";
+    ({ eq } = await import("drizzle-orm"));
+    dbmod = await import("@/server/db/client");
+    schema = await import("@/server/db/schema");
+    orders = await import("@/server/modules/orders/db-orders");
+    billing = await import("@/server/modules/billing/db-billing");
+    customer = await import("@/server/modules/customer/actions");
+    const all = (await import("@/server/modules/demo-store/store")).getMenu();
+    menu = all.filter((m) => m.available && !m.discountPercent);
+  });
+
+  async function servedOrder(tableId: string) {
+    const lines = [
+      { code: menu[0].code, itemId: menu[0].id, qty: 1 },
+      { code: menu[1].code, itemId: menu[1].id, qty: 2 },
+      { code: menu[2].code, itemId: menu[2].id, qty: 3 },
+    ];
+    const placed = await orders.createOrderInDb({ restaurantId: RID, tableId, lines });
+    if (!placed.ok) throw new Error(placed.error);
+    for (let i = 0; i < 3; i += 1) await orders.transitionOrderInDb(RID, placed.orderId);
+    return placed.orderId;
+  }
+
+  it("persists line items with name, qty, unit price and line total", async () => {
+    const orderId = await servedOrder("t03");
+    const rows = await dbmod.db.select().from(schema.orderItems).where(eq(schema.orderItems.orderId, orderId));
+
+    expect(rows).toHaveLength(3);
+    for (const r of rows) {
+      expect(r.nameSnapshot.length).toBeGreaterThan(0);
+      expect(r.pricePaise).toBeGreaterThan(0);
+      expect(r.lineTotalPaise).toBe(r.qty * r.pricePaise);
+    }
+    const [o] = await dbmod.db.select().from(schema.orders).where(eq(schema.orders.id, orderId));
+    expect(o.restaurantId).toBe(RID);
+    expect(o.tableId).toBe("t03");
+    expect(o.orderNumber).toBeGreaterThan(0);
+  });
+
+  it("generates an unpaid, itemised bill that survives a refresh; no duplicates", async () => {
+    const orderId = await servedOrder("t03");
+
+    const gen = await customer.generateCustomerBill("t03", orderId);
+    expect(gen.ok).toBe(true);
+    if (!gen.ok) return;
+    const r = gen.bill.receipt;
+
+    // Items from the DB, with correct arithmetic.
+    expect(r.lines.map((l) => l.qty).sort()).toEqual([1, 2, 3]);
+    for (const l of r.lines) expect(l.lineRupees).toBeCloseTo(l.qty * l.unitRupees, 2);
+    const sum = r.lines.reduce((s, l) => s + l.lineRupees, 0);
+    expect(r.subtotalRupees).toBeCloseTo(sum, 2);
+    expect(r.totalRupees).toBeCloseTo(
+      r.subtotalRupees + r.gstRupees + r.serviceChargeRupees - r.discountRupees, 2);
+
+    // Header facts.
+    expect(r.billNumber).toMatch(/^BILL-\d{3,}$/);
+    expect(r.orderNumber).toMatch(/^ORD-\d{3,}$/);
+    expect(r.tableLabel).toBe("Table 03");
+    expect(Number.isNaN(Date.parse(r.issuedAt))).toBe(false);
+
+    // Generating a bill never marks it paid.
+    expect(r.status).toBe("unpaid");
+    expect(r.paidRupees).toBe(0);
+    expect(r.remainingRupees).toBeCloseTo(r.totalRupees, 2);
+    expect(r.payments).toEqual([]);
+    const [b] = await dbmod.db.select().from(schema.bills).where(eq(schema.bills.orderId, orderId));
+    expect(b.paidAt).toBeNull();
+    expect(b.paymentMethod).toBeNull();
+    // QR is only a display string; showing it records nothing.
+    expect(gen.bill.upiUri).toContain("upi://pay");
+    expect(await billing.isOrderPaidDb(RID, orderId)).toBe(false);
+
+    // "Refresh": a fresh read returns the identical bill + items from Postgres.
+    const again = await customer.getCustomerOrderState("t03", orderId);
+    expect(again.ok && again.bill?.receipt).toEqual(r);
+
+    // Generating again returns the same bill; exactly one bill row exists.
+    const gen2 = await customer.generateCustomerBill("t03", orderId);
+    expect(gen2.ok && gen2.bill.billId).toBe(gen.bill.billId);
+    const all = await dbmod.db.select().from(schema.bills).where(eq(schema.bills.orderId, orderId));
+    expect(all).toHaveLength(1);
+  });
+
+  it("keeps total / paid / balance consistent through partial cash then full payment", async () => {
+    const orderId = await servedOrder("t02");
+    const gen = await customer.generateCustomerBill("t02", orderId);
+    if (!gen.ok) throw new Error(gen.error);
+    const { billId, totalRupees } = gen.bill;
+
+    const part = Math.floor(totalRupees / 2);
+    const p1 = await billing.recordBillPaymentDb(RID, billId, { method: "cash", amountRupees: part });
+    expect(p1.ok).toBe(true);
+
+    const mid = await customer.getCustomerOrderState("t02", orderId);
+    if (!mid.ok || !mid.bill) throw new Error("no state");
+    expect(mid.bill.receipt.status).toBe("partial");
+    expect(mid.bill.receipt.paidRupees).toBe(part);
+    expect(mid.bill.receipt.remainingRupees).toBeCloseTo(totalRupees - part, 2);
+    expect(mid.bill.receipt.payments).toMatchObject([{ method: "cash", amountRupees: part }]);
+    const [open] = await dbmod.db.select().from(schema.bills).where(eq(schema.bills.id, billId));
+    expect(open.paidAt).toBeNull(); // partially paid ≠ closed
+
+    const over = await billing.recordBillPaymentDb(RID, billId, { method: "cash", amountRupees: totalRupees });
+    expect(over).toMatchObject({ ok: false, reason: "overpayment" });
+
+    const p2 = await billing.recordBillPaymentDb(RID, billId, { method: "cash", amountRupees: totalRupees - part });
+    expect(p2.ok && p2.settled).toBe(true);
+
+    const done = await customer.getCustomerOrderState("t02", orderId);
+    expect(done.ok && done.bill?.receipt).toMatchObject({ status: "paid", remainingRupees: 0, paidRupees: totalRupees });
+    const [closed] = await dbmod.db.select().from(schema.bills).where(eq(schema.bills.id, billId));
+    expect(closed.paidAt).not.toBeNull();
+  });
+
+  it("shows the QR payment method and reference on the receipt, and rejects a duplicate payment reference", async () => {
+    const orderId = await servedOrder("t01");
+    const gen = await customer.generateCustomerBill("t01", orderId);
+    if (!gen.ok) throw new Error(gen.error);
+
+    const pay = await billing.recordBillPaymentDb(RID, gen.bill.billId, {
+      method: "qr", amountRupees: gen.bill.totalRupees, transactionId: REF,
+    });
+    expect(pay.ok).toBe(true);
+
+    const st = await customer.getCustomerOrderState("t01", orderId);
+    if (!st.ok || !st.bill) throw new Error("no state");
+    expect(st.bill.receipt.status).toBe("paid");
+    expect(st.bill.receipt.payments).toMatchObject([{ method: "qr", transactionId: REF }]);
+
+    // Same reference on another bill is refused.
+    const order2 = await servedOrder("t04");
+    const gen2 = await customer.generateCustomerBill("t04", order2);
+    if (!gen2.ok) throw new Error(gen2.error);
+    const dup = await billing.recordBillPaymentDb(RID, gen2.bill.billId, {
+      method: "qr", amountRupees: gen2.bill.totalRupees, transactionId: REF.toUpperCase(),
+    });
+    expect(dup).toMatchObject({ ok: false, reason: "duplicate-reference" });
+  });
+
+  it("customer action for another table cannot read this order's bill", async () => {
+    const orderId = await servedOrder("t05");
+    const wrong = await customer.getCustomerOrderState("t06", orderId);
+    expect(wrong).toMatchObject({ ok: false });
+  });
+});
