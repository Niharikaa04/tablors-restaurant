+"use client";
+
+import type { BillReceipt } from "@/server/modules/billing/db-billing";
+
+/**
+ * Itemised restaurant receipt. Every value comes from the BillReceipt that the
+ * server read from PostgreSQL; nothing is recomputed or invented here.
+ */
+
+export function money(value: number): string {
+  return `₹${value.toLocaleString("en-IN", {
+    minimumFractionDigits: Number.isInteger(value) ? 0 : 2,
+    maximumFractionDigits: 2,
+  })}`;
+}
+
+export function statusLabel(status: BillReceipt["status"]): string {
+  switch (status) {
+    case "paid":
+      return "Paid";
+    case "partial":
+      return "Partially Paid";
+    case "refunded":
+      return "Refunded";
+    default:
+      return "Pending";
+  }
+}
+
+function methodLabel(method: "cash" | "qr"): string {
+  return method === "qr" ? "QR" : "Cash";
+}
+
+export function formatReceiptDate(iso: string): string {
+  return new Date(iso).toLocaleString("en-IN", {
+    timeZone: "Asia/Kolkata",
+    day: "2-digit",
+    month: "short",
+    year: "numeric",
+    hour: "2-digit",
+    minute: "2-digit",
+    hour12: true,
+  });
+}
+
+export function BillReceiptView({
+  receipt,
+  restaurantName,
+}: {
+  receipt: BillReceipt;
+  restaurantName: string;
+}) {
+  const hasAdjustments =
+    receipt.gstRupees > 0 ||
+    receipt.serviceChargeRupees > 0 ||
+    receipt.discountRupees > 0;
+
+  return (
+    <div
+      className="rounded-lg bg-white p-4 text-[12px] leading-5 text-neutral-900"
+      data-testid="bill-receipt"
+    >
+      <div className="text-center">
+        <p className="text-sm font-bold uppercase tracking-wide">
+          {restaurantName} — Restaurant Bill
+        </p>
+      </div>
+
+      <dl className="mt-3 space-y-0.5">
+        <div className="flex justify-between">
+          <dt>Bill No</dt>
+          <dd className="font-semibold">{receipt.billNumber}</dd>
+        </div>
+        {receipt.orderNumber && (
+          <div className="flex justify-between">
+            <dt>Order No</dt>
+            <dd className="font-semibold">{receipt.orderNumber}</dd>
+          </div>
+        )}
+        <div className="flex justify-between">
+          <dt>Date</dt>
+          <dd>{formatReceiptDate(receipt.issuedAt)}</dd>
+        </div>
+        <div className="flex justify-between">
+          <dt>Table</dt>
+          <dd className="font-semibold">{receipt.tableLabel}</dd>
+        </div>
+      </dl>
+
+      <table className="mt-3 w-full border-t border-dashed border-neutral-400">
+        <thead>
+          <tr className="border-b border-dashed border-neutral-400 text-left">
+            <th className="py-1 font-semibold">Item</th>
+            <th className="py-1 text-right font-semibold">Qty</th>
+            <th className="py-1 text-right font-semibold">Price</th>
+            <th className="py-1 text-right font-semibold">Amount</th>
+          </tr>
+        </thead>
+        <tbody>
+          {receipt.lines.map((line, i) => (
+            <tr key={`${line.name}-${i}`} className="align-top">
+              <td className="py-0.5 pr-2">{line.name}</td>
+              <td className="py-0.5 text-right">{line.qty}</td>
+              <td className="py-0.5 text-right">{money(line.unitRupees)}</td>
+              <td className="py-0.5 text-right">{money(line.lineRupees)}</td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+
+      <div className="mt-2 space-y-0.5 border-t border-dashed border-neutral-400 pt-2">
+        <div className="flex justify-between">
+          <span>Subtotal</span>
+          <span>{money(receipt.subtotalRupees)}</span>
+        </div>
+        {receipt.gstRupees > 0 && (
+          <div className="flex justify-between">
+            <span>GST</span>
+            <span>{money(receipt.gstRupees)}</span>
+          </div>
+        )}
+        {receipt.serviceChargeRupees > 0 && (
+          <div className="flex justify-between">
+            <span>Service charge</span>
+            <span>{money(receipt.serviceChargeRupees)}</span>
+          </div>
+        )}
+        {receipt.discountRupees > 0 && (
+          <div className="flex justify-between">
+            <span>Discount</span>
+            <span>−{money(receipt.discountRupees)}</span>
+          </div>
+        )}
+        {!hasAdjustments && (
+          <div className="flex justify-between text-neutral-500">
+            <span>Tax / discount</span>
+            <span>None</span>
+          </div>
+        )}
+        <div className="flex justify-between border-t border-neutral-400 pt-1 text-sm font-bold">
+          <span>Total</span>
+          <span>{money(receipt.totalRupees)}</span>
+        </div>
+        <div className="flex justify-between">
+          <span>Paid</span>
+          <span>{money(receipt.paidRupees)}</span>
+        </div>
+        <div className="flex justify-between font-semibold">
+          <span>Balance Due</span>
+          <span>{money(receipt.remainingRupees)}</span>
+        </div>
+      </div>
+
+      {receipt.payments.length > 0 && (
+        <div className="mt-2 border-t border-dashed border-neutral-400 pt-2">
+          <p className="font-semibold">Payments</p>
+          {receipt.payments.map((p, i) => (
+            <div key={i} className="flex justify-between gap-2">
+              <span>
+                {methodLabel(p.method)}
+                {p.transactionId ? ` · Ref ${p.transactionId}` : ""}
+              </span>
+              <span>{money(p.amountRupees)}</span>
+            </div>
+          ))}
+        </div>
+      )}
+
+      <p className="mt-3 border-t border-dashed border-neutral-400 pt-2 text-center font-bold uppercase">
+        Payment Status: {statusLabel(receipt.status)}
+      </p>
+    </div>
+  );
+}
+
+function esc(value: string): string {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;");
+}
+
+/** Prints only the receipt (hidden iframe, no popup blocker, no global CSS). */
+export function printReceipt(receipt: BillReceipt, restaurantName: string): void {
+  const rows = receipt.lines
+    .map(
+      (l) =>
+        `<tr><td>${esc(l.name)}</td><td class="r">${l.qty}</td><td class="r">${esc(
+          money(l.unitRupees)
+        )}</td><td class="r">${esc(money(l.lineRupees))}</td></tr>`
+    )
+    .join("");
+
+  const row = (label: string, value: string, cls = "") =>
+    `<div class="row ${cls}"><span>${esc(label)}</span><span>${esc(value)}</span></div>`;
+
+  const payments = receipt.payments
+    .map((p) =>
+      row(
+        `${methodLabel(p.method)}${p.transactionId ? ` · Ref ${p.transactionId}` : ""}`,
+        money(p.amountRupees)
+      )
+    )
+    .join("");
+
+  const html = `<!doctype html><html><head><meta charset="utf-8"><title>${esc(
+    receipt.billNumber
+  )}</title><style>
+    @page { margin: 8mm; }
+    body { font: 12px/1.5 "Courier New", monospace; color: #000; max-width: 360px; margin: 0 auto; }
+    h1 { font-size: 14px; text-align: center; text-transform: uppercase; margin: 0 0 8px; }
+    .row { display: flex; justify-content: space-between; gap: 8px; }
+    .b { font-weight: 700; } .tot { font-size: 14px; font-weight: 700; border-top: 1px solid #000; margin-top: 4px; padding-top: 4px; }
+    table { width: 100%; border-collapse: collapse; margin: 8px 0; border-top: 1px dashed #000; }
+    th, td { text-align: left; padding: 2px 0; vertical-align: top; } th { border-bottom: 1px dashed #000; }
+    .r { text-align: right; } .sec { border-top: 1px dashed #000; margin-top: 6px; padding-top: 6px; }
+    .c { text-align: center; font-weight: 700; text-transform: uppercase; }
+  </style></head><body>
+    <h1>${esc(restaurantName)} — Restaurant Bill</h1>
+    ${row("Bill No", receipt.billNumber, "b")}
+    ${receipt.orderNumber ? row("Order No", receipt.orderNumber, "b") : ""}
+    ${row("Date", formatReceiptDate(receipt.issuedAt))}
+    ${row("Table", receipt.tableLabel, "b")}
+    <table><thead><tr><th>Item</th><th class="r">Qty</th><th class="r">Price</th><th class="r">Amount</th></tr></thead><tbody>${rows}</tbody></table>
+    <div class="sec">
+      ${row("Subtotal", money(receipt.subtotalRupees))}
+      ${receipt.gstRupees > 0 ? row("GST", money(receipt.gstRupees)) : ""}
+      ${receipt.serviceChargeRupees > 0 ? row("Service charge", money(receipt.serviceChargeRupees)) : ""}
+      ${receipt.discountRupees > 0 ? row("Discount", `-${money(receipt.discountRupees)}`) : ""}
+      ${row("Total", money(receipt.totalRupees), "tot")}
+      ${row("Paid", money(receipt.paidRupees))}
+      ${row("Balance Due", money(receipt.remainingRupees), "b")}
+    </div>
+    ${payments ? `<div class="sec"><div class="b">Payments</div>${payments}</div>` : ""}
+    <div class="sec c">Payment Status: ${esc(statusLabel(receipt.status))}</div>
+  </body></html>`;
+
+  const frame = document.createElement("iframe");
+  frame.setAttribute("aria-hidden", "true");
+  frame.style.cssText =
+    "position:fixed;right:0;bottom:0;width:0;height:0;border:0;visibility:hidden";
+  document.body.appendChild(frame);
+
+  const doc = frame.contentDocument;
+  const win = frame.contentWindow;
+  if (!doc || !win) {
+    frame.remove();
+    return;
+  }
+
+  doc.open();
+  doc.write(html);
+  doc.close();
+
+  const cleanup = () => window.setTimeout(() => frame.remove(), 500);
+  win.addEventListener("afterprint", cleanup);
+  window.setTimeout(() => {
+    win.focus();
+    win.print();
+  }, 100);
+  // Safety net in case afterprint never fires.
+  window.setTimeout(() => frame.remove(), 60_000);
+}
