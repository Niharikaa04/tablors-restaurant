+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it } from "vitest";
+import { PaymentPanel } from "@/components/customer/device/payment-panel";
+import type { CustomerBillState } from "@/server/modules/customer/actions";
+
+function state(over: Partial<CustomerBillState["receipt"]> = {}): CustomerBillState {
+  const receipt = {
+    billNumber: "BILL-007",
+    orderNumber: "ORD-012",
+    issuedAt: "2026-10-17T10:30:00.000Z",
+    tableLabel: "Table 05",
+    lines: [
+      { name: "Fish Fingers", qty: 1, unitRupees: 250, lineRupees: 250 },
+      { name: "Butter Naan", qty: 2, unitRupees: 40, lineRupees: 80 },
+    ],
+    subtotalRupees: 330,
+    gstRupees: 17,
+    serviceChargeRupees: 0,
+    discountRupees: 0,
+    totalRupees: 347,
+    paidRupees: 0,
+    remainingRupees: 347,
+    status: "unpaid" as const,
+    payments: [],
+    ...over,
+  };
+  return {
+    billId: "uuid-should-not-be-shown",
+    totalRupees: receipt.totalRupees,
+    paidRupees: receipt.paidRupees,
+    remainingRupees: receipt.remainingRupees,
+    status: receipt.status,
+    upiConfigured: true,
+    upiUri: "upi://pay?pa=tablor%40upi&pn=Tablor&am=347&cu=INR",
+    qrUrl: null,
+    restaurantName: "Tablor's",
+    receipt,
+  };
+}
+
+const render = (bill: CustomerBillState, mode: "bill" | "qr") =>
+  renderToStaticMarkup(createElement(PaymentPanel, { bill, mode, onClose: () => {} }));
+
+describe("PaymentPanel", () => {
+  it("bill popup lists items, totals, and Pending status", () => {
+    const html = render(state(), "bill");
+    for (const t of ["BILL-007", "ORD-012", "Table 05", "Fish Fingers", "Butter Naan", "₹250", "₹80",
+      "Subtotal", "₹330", "GST", "₹17", "₹347", "Balance Due", "Payment Status: Pending"]) {
+      expect(html).toContain(t);
+    }
+    expect(html).not.toContain("uuid-should-not-be-shown");
+    expect(html).not.toContain("Open UPI App");
+  });
+
+  it("shows partial and paid statuses with payment method and reference", () => {
+    const partial = render(state({ status: "partial", paidRupees: 100, remainingRupees: 247,
+      payments: [{ method: "cash", amountRupees: 100, transactionId: null, paidAt: "2026-10-17T10:40:00.000Z" }] }), "bill");
+    expect(partial).toContain("Payment Status: Partially Paid");
+    expect(partial).toContain("Cash");
+
+    const paid = render(state({ status: "paid", paidRupees: 347, remainingRupees: 0,
+      payments: [{ method: "qr", amountRupees: 347, transactionId: "UTR123456789", paidAt: "2026-10-17T10:40:00.000Z" }] }), "bill");
+    expect(paid).toContain("Payment Status: Paid");
+    expect(paid).toContain("Ref UTR123456789");
+  });
+
+  it("QR popup keeps the QR and UPI id but has no Open UPI App button or upi:// link", () => {
+    const html = render(state(), "qr");
+    expect(html).toContain("<svg");              // QR code still rendered
+    expect(html).toContain("UPI ID: tablor@upi"); // UPI id still shown
+    expect(html).not.toContain("Open UPI App");
+    expect(html).not.toMatch(/<a[^>]+href="upi:/);
+  });
+});
