# ==========================================================
# TABLOR'S — Environment Configuration Template
# Copy to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.
# ==========================================================

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE_DISPLAY=Asia/Kolkata

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://user:password@localhost:5432/tablors

# --- Sessions / Auth ---
SESSION_SECRET=replace-with-a-strong-random-secret
SESSION_COOKIE_NAME=tablors_session
# Argon2id tuning (documented defaults, confirm before production)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- PIN step-up auth (financial views) ---
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# --- Rate limiting ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30

# --- Device auth (table ordering devices) ---
# Protocol is an open decision (HTTPS / MQTT / WebSocket) — see docs/open-decisions.md
DEVICE_AUTH_SECRET=replace-with-a-strong-random-secret
DEVICE_HEARTBEAT_INTERVAL_SECONDS=30
DEVICE_OFFLINE_THRESHOLD_SECONDS=90

# --- Realtime (SSE) ---
REALTIME_HEARTBEAT_INTERVAL_SECONDS=15

# --- Spam protection / demo form ---
DEMO_FORM_RATE_LIMIT_PER_HOUR=5

# --- Company admin ---
COMPANY_ADMIN_EMAIL=

# --- Contact / business placeholders (DO NOT hardcode real values in code) ---
PUBLIC_CONTACT_PHONE=
PUBLIC_CONTACT_EMAIL=
PUBLIC_SUPPORT_URL=

# --- Future: Financial Pots (not active in V1) ---
FINANCIAL_POTS_ENABLED=false
